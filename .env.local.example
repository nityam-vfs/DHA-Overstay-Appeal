# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these under Project Settings > API in the Supabase dashboard.

# Public (safe for browser) — used by the Next.js app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never commit.
# Only used by scripts/seed-supabase.ts to seed demo data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket used for appeal documents & letters.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=appeal-documents
